{
  "$schema": "https://sing-box.sagernet.org/schema.json",
  "log": {
    "disabled": false,
    "level": "warn",
    "timestamp": true
  },
  "dns": {
    "servers": [
      {
        "type": "https",
        "tag": "direct-dns",
        "server": "223.5.5.5",
        "domain_resolver": "direct-dns-bootstrap"
      },
      {
        "type": "udp",
        "tag": "direct-dns-bootstrap",
        "server": "223.5.5.5"
      },
      {
        "type": "https",
        "tag": "proxy-dns",
        "server": "8.8.8.8",
        "detour": "select"
      }
    ],
    "rules": [
      {
        "clash_mode": "Direct",
        "action": "route",
        "server": "direct-dns"
      },
      {
        "clash_mode": "Global",
        "action": "route",
        "server": "proxy-dns"
      },
      {
        "rule_set": "geosite-cn",
        "action": "route",
        "server": "direct-dns"
      },
      {
        "rule_set": "geolocation-!cn",
        "action": "route",
        "server": "proxy-dns"
      }
    ],
    "final": "proxy-dns",
    "strategy": "prefer_ipv4"
  },
  "inbounds": [
    {
      "type": "tun",
      "tag": "tun-in",
      "address": [
        "172.19.0.1/30",
        "fdfe:dcba:9876::1/126"
      ],
      "mtu": 9000,
      "auto_route": true,
      "stack": "system"
    }
  ],
  "outbounds": [
    {
      "type": "hysteria2",
      "tag": "proxy-example",
      "server": "example.com",
      "server_port": 443,
      "password": "CHANGE_ME",
      "tls": {
        "enabled": true,
        "server_name": "example.com",
        "insecure": false
      }
    },
    {
      "type": "selector",
      "tag": "select",
      "outbounds": [
        "auto",
        "udp-auto",
        "proxy-example"
      ],
      "default": "auto"
    },
    {
      "type": "urltest",
      "tag": "auto",
      "outbounds": [
        "proxy-example"
      ],
      "url": "https://www.gstatic.com/generate_204",
      "interval": "3m",
      "tolerance": 150,
      "interrupt_exist_connections": false
    },
    {
      "type": "urltest",
      "tag": "udp-auto",
      "outbounds": [
        "proxy-example"
      ],
      "url": "https://www.gstatic.com/generate_204",
      "interval": "3m",
      "tolerance": 150,
      "interrupt_exist_connections": false
    },
    {
      "type": "selector",
      "tag": "streaming",
      "outbounds": [
        "select",
        "auto",
        "udp-auto",
        "direct"
      ],
      "default": "select",
      "interrupt_exist_connections": false
    },
    {
      "type": "selector",
      "tag": "ai",
      "outbounds": [
        "select",
        "auto",
        "udp-auto",
        "direct"
      ],
      "default": "select",
      "interrupt_exist_connections": false
    },
    {
      "type": "selector",
      "tag": "telegram",
      "outbounds": [
        "select",
        "auto",
        "udp-auto",
        "direct"
      ],
      "default": "select",
      "interrupt_exist_connections": false
    },
    {
      "type": "selector",
      "tag": "microsoft",
      "outbounds": [
        "select",
        "auto",
        "udp-auto",
        "direct"
      ],
      "default": "direct",
      "interrupt_exist_connections": false
    },
    {
      "type": "selector",
      "tag": "apple",
      "outbounds": [
        "select",
        "auto",
        "udp-auto",
        "direct"
      ],
      "default": "direct",
      "interrupt_exist_connections": false
    },
    {
      "type": "selector",
      "tag": "google",
      "outbounds": [
        "select",
        "auto",
        "udp-auto",
        "direct"
      ],
      "default": "select",
      "interrupt_exist_connections": false
    },
    {
      "type": "selector",
      "tag": "github",
      "outbounds": [
        "select",
        "auto",
        "udp-auto",
        "direct"
      ],
      "default": "select",
      "interrupt_exist_connections": false
    },
    {
      "type": "direct",
      "tag": "direct"
    },
    {
      "type": "selector",
      "tag": "GLOBAL",
      "outbounds": [
        "select",
        "auto",
        "udp-auto",
        "proxy-example",
        "direct"
      ],
      "default": "select",
      "interrupt_exist_connections": false
    }
  ],
  "route": {
    "rules": [
      {
        "action": "sniff"
      },
      {
        "type": "logical",
        "mode": "or",
        "rules": [
          {
            "protocol": "dns"
          },
          {
            "port": 53
          }
        ],
        "action": "hijack-dns"
      },
      {
        "action": "resolve",
        "strategy": "prefer_ipv4"
      },
      {
        "ip_is_private": true,
        "action": "route",
        "outbound": "direct"
      },
      {
        "clash_mode": "Direct",
        "action": "route",
        "outbound": "direct"
      },
      {
        "clash_mode": "Global",
        "action": "route",
        "outbound": "GLOBAL"
      },
      {
        "rule_set": "category-ads-all",
        "action": "reject"
      },
      {
        "rule_set": "geosite-private",
        "action": "route",
        "outbound": "direct"
      },
      {
        "rule_set": "geosite-cn",
        "action": "route",
        "outbound": "direct"
      },
      {
        "type": "logical",
        "mode": "and",
        "rules": [
          {
            "rule_set": "geoip-cn"
          },
          {
            "rule_set": "geolocation-!cn",
            "invert": true
          }
        ],
        "action": "route",
        "outbound": "direct"
      },
      {
        "network": "udp",
        "action": "route",
        "outbound": "udp-auto"
      },
      {
        "rule_set": "category-ai-!cn",
        "action": "route",
        "outbound": "ai"
      },
      {
        "rule_set": "youtube",
        "action": "route",
        "outbound": "streaming"
      },
      {
        "rule_set": "netflix",
        "action": "route",
        "outbound": "streaming"
      },
      {
        "rule_set": "disney",
        "action": "route",
        "outbound": "streaming"
      },
      {
        "rule_set": "spotify",
        "action": "route",
        "outbound": "streaming"
      },
      {
        "rule_set": "tiktok",
        "action": "route",
        "outbound": "streaming"
      },
      {
        "rule_set": "telegram",
        "action": "route",
        "outbound": "telegram"
      },
      {
        "rule_set": "microsoft",
        "action": "route",
        "outbound": "microsoft"
      },
      {
        "rule_set": "onedrive",
        "action": "route",
        "outbound": "microsoft"
      },
      {
        "rule_set": "apple",
        "action": "route",
        "outbound": "apple"
      },
      {
        "rule_set": "google",
        "action": "route",
        "outbound": "google"
      },
      {
        "rule_set": "github",
        "action": "route",
        "outbound": "github"
      },
      {
        "rule_set": "geolocation-!cn",
        "action": "route",
        "outbound": "select"
      }
    ],
    "rule_set": [
      {
        "type": "remote",
        "tag": "category-ads-all",
        "format": "binary",
        "url": "https://testingcf.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@sing/geo/geosite/category-ads-all.srs",
        "http_client": "rule-set-direct"
      },
      {
        "type": "remote",
        "tag": "geosite-private",
        "format": "binary",
        "url": "https://testingcf.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@sing/geo/geosite/private.srs",
        "http_client": "rule-set-direct"
      },
      {
        "type": "remote",
        "tag": "geoip-cn",
        "format": "binary",
        "url": "https://testingcf.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@sing/geo/geoip/cn.srs",
        "http_client": "rule-set-direct"
      },
      {
        "type": "remote",
        "tag": "geosite-cn",
        "format": "binary",
        "url": "https://testingcf.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@sing/geo/geosite/cn.srs",
        "http_client": "rule-set-direct"
      },
      {
        "type": "remote",
        "tag": "geolocation-!cn",
        "format": "binary",
        "url": "https://testingcf.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@sing/geo/geosite/geolocation-!cn.srs",
        "http_client": "rule-set-direct"
      },
      {
        "type": "remote",
        "tag": "category-ai-!cn",
        "format": "binary",
        "url": "https://testingcf.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@sing/geo/geosite/category-ai-!cn.srs",
        "http_client": "rule-set-direct"
      },
      {
        "type": "remote",
        "tag": "youtube",
        "format": "binary",
        "url": "https://testingcf.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@sing/geo/geosite/youtube.srs",
        "http_client": "rule-set-direct"
      },
      {
        "type": "remote",
        "tag": "netflix",
        "format": "binary",
        "url": "https://testingcf.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@sing/geo/geosite/netflix.srs",
        "http_client": "rule-set-direct"
      },
      {
        "type": "remote",
        "tag": "disney",
        "format": "binary",
        "url": "https://testingcf.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@sing/geo/geosite/disney.srs",
        "http_client": "rule-set-direct"
      },
      {
        "type": "remote",
        "tag": "spotify",
        "format": "binary",
        "url": "https://testingcf.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@sing/geo/geosite/spotify.srs",
        "http_client": "rule-set-direct"
      },
      {
        "type": "remote",
        "tag": "tiktok",
        "format": "binary",
        "url": "https://testingcf.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@sing/geo/geosite/tiktok.srs",
        "http_client": "rule-set-direct"
      },
      {
        "type": "remote",
        "tag": "telegram",
        "format": "binary",
        "url": "https://testingcf.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@sing/geo/geosite/telegram.srs",
        "http_client": "rule-set-direct"
      },
      {
        "type": "remote",
        "tag": "microsoft",
        "format": "binary",
        "url": "https://testingcf.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@sing/geo/geosite/microsoft.srs",
        "http_client": "rule-set-direct"
      },
      {
        "type": "remote",
        "tag": "onedrive",
        "format": "binary",
        "url": "https://testingcf.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@sing/geo/geosite/onedrive.srs",
        "http_client": "rule-set-direct"
      },
      {
        "type": "remote",
        "tag": "apple",
        "format": "binary",
        "url": "https://testingcf.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@sing/geo/geosite/apple.srs",
        "http_client": "rule-set-direct"
      },
      {
        "type": "remote",
        "tag": "google",
        "format": "binary",
        "url": "https://testingcf.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@sing/geo/geosite/google.srs",
        "http_client": "rule-set-direct"
      },
      {
        "type": "remote",
        "tag": "github",
        "format": "binary",
        "url": "https://testingcf.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@sing/geo/geosite/github.srs",
        "http_client": "rule-set-direct"
      }
    ],
    "final": "select",
    "default_domain_resolver": {
      "server": "direct-dns"
    },
    "default_http_client": "rule-set-direct"
  },
  "experimental": {
    "clash_api": {
      "default_mode": "Rule"
    },
    "cache_file": {
      "enabled": true,
      "cache_id": "android-dual-stack"
    }
  },
  "http_clients": [
    {
      "tag": "rule-set-direct",
      "domain_resolver": {
        "server": "direct-dns-bootstrap",
        "strategy": "ipv4_only"
      }
    }
  ]
}
