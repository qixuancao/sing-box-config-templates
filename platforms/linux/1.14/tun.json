{
  "$schema": "https://sing-box.sagernet.org/schema.json",
  "log": {
    "disabled": false,
    "level": "warn",
    "timestamp": true
  },
  "dns": {
    "servers": [
      {
        "type": "https",
        "tag": "direct-dns",
        "server": "223.5.5.5",
        "domain_resolver": "direct-dns-bootstrap"
      },
      {
        "type": "udp",
        "tag": "direct-dns-bootstrap",
        "server": "223.5.5.5"
      },
      {
        "type": "https",
        "tag": "proxy-dns",
        "server": "8.8.8.8",
        "detour": "select"
      }
    ],
    "rules": [
      {
        "query_type": [
          "AAAA",
          "HTTPS",
          "SVCB"
        ],
        "action": "predefined",
        "rcode": "NOERROR"
      },
      {
        "clash_mode": "Direct",
        "action": "route",
        "server": "direct-dns"
      },
      {
        "clash_mode": "Global",
        "action": "route",
        "server": "proxy-dns"
      },
      {
        "rule_set": "geosite-cn",
        "action": "route",
        "server": "direct-dns"
      },
      {
        "rule_set": "geolocation-!cn",
        "action": "route",
        "server": "proxy-dns"
      }
    ],
    "final": "proxy-dns",
    "strategy": "ipv4_only"
  },
  "inbounds": [
    {
      "type": "tun",
      "tag": "tun-in",
      "address": [
        "172.19.0.1/30"
      ],
      "mtu": 9000,
      "auto_route": true,
      "stack": "system",
      "strict_route": true,
      "auto_redirect": true,
      "dns_mode": "hijack",
      "route_exclude_address": [
        "10.0.0.0/8",
        "100.64.0.0/10",
        "127.0.0.0/8",
        "169.254.0.0/16",
        "172.16.0.0/15",
        "172.18.0.0/16",
        "172.19.0.4/30",
        "172.19.0.8/29",
        "172.19.0.16/28",
        "172.19.0.32/27",
        "172.19.0.64/26",
        "172.19.0.128/25",
        "172.19.1.0/24",
        "172.19.2.0/23",
        "172.19.4.0/22",
        "172.19.8.0/21",
        "172.19.16.0/20",
        "172.19.32.0/19",
        "172.19.64.0/18",
        "172.19.128.0/17",
        "172.20.0.0/14",
        "172.24.0.0/13",
        "192.168.0.0/16",
        "224.0.0.0/4",
        "255.255.255.255/32",
        "::1/128",
        "fc00::/7",
        "fe80::/10",
        "ff00::/8"
      ]
    }
  ],
  "outbounds": [
    {
      "type": "hysteria2",
      "tag": "proxy-example",
      "server": "example.com",
      "server_port": 443,
      "password": "CHANGE_ME",
      "tls": {
        "enabled": true,
        "server_name": "example.com",
        "insecure": false
      }
    },
    {
      "type": "selector",
      "tag": "select",
      "outbounds": [
        "auto",
        "proxy-example"
      ],
      "default": "auto"
    },
    {
      "type": "urltest",
      "tag": "auto",
      "outbounds": [
        "proxy-example"
      ],
      "url": "https://www.gstatic.com/generate_204",
      "interval": "10m",
      "tolerance": 150,
      "interrupt_exist_connections": false
    },
    {
      "type": "selector",
      "tag": "streaming",
      "outbounds": [
        "select",
        "auto",
        "direct"
      ],
      "default": "select",
      "interrupt_exist_connections": false
    },
    {
      "type": "selector",
      "tag": "ai",
      "outbounds": [
        "select",
        "auto",
        "direct"
      ],
      "default": "select",
      "interrupt_exist_connections": false
    },
    {
      "type": "selector",
      "tag": "telegram",
      "outbounds": [
        "select",
        "auto",
        "direct"
      ],
      "default": "select",
      "interrupt_exist_connections": false
    },
    {
      "type": "selector",
      "tag": "microsoft",
      "outbounds": [
        "select",
        "auto",
        "direct"
      ],
      "default": "select",
      "interrupt_exist_connections": false
    },
    {
      "type": "selector",
      "tag": "apple",
      "outbounds": [
        "select",
        "auto",
        "direct"
      ],
      "default": "select",
      "interrupt_exist_connections": false
    },
    {
      "type": "selector",
      "tag": "google",
      "outbounds": [
        "select",
        "auto",
        "direct"
      ],
      "default": "select",
      "interrupt_exist_connections": false
    },
    {
      "type": "selector",
      "tag": "github",
      "outbounds": [
        "select",
        "auto",
        "direct"
      ],
      "default": "select",
      "interrupt_exist_connections": false
    },
    {
      "type": "direct",
      "tag": "direct"
    },
    {
      "type": "selector",
      "tag": "GLOBAL",
      "outbounds": [
        "select",
        "auto",
        "proxy-example",
        "direct"
      ],
      "default": "select",
      "interrupt_exist_connections": false
    }
  ],
  "route": {
    "rules": [
      {
        "action": "sniff"
      },
      {
        "type": "logical",
        "mode": "or",
        "rules": [
          {
            "protocol": "dns"
          },
          {
            "port": 53
          }
        ],
        "action": "hijack-dns"
      },
      {
        "action": "resolve",
        "strategy": "ipv4_only"
      },
      {
        "ip_version": 6,
        "action": "reject"
      },
      {
        "ip_is_private": true,
        "action": "route",
        "outbound": "direct"
      },
      {
        "clash_mode": "Direct",
        "action": "route",
        "outbound": "direct"
      },
      {
        "clash_mode": "Global",
        "action": "route",
        "outbound": "GLOBAL"
      },
      {
        "rule_set": "geosite-private",
        "action": "route",
        "outbound": "direct"
      },
      {
        "rule_set": "geosite-cn",
        "action": "route",
        "outbound": "direct"
      },
      {
        "type": "logical",
        "mode": "and",
        "rules": [
          {
            "rule_set": "geoip-cn"
          },
          {
            "rule_set": "geolocation-!cn",
            "invert": true
          }
        ],
        "action": "route",
        "outbound": "direct"
      },
      {
        "rule_set": "category-ai-!cn",
        "action": "route",
        "outbound": "ai"
      },
      {
        "rule_set": "youtube",
        "action": "route",
        "outbound": "streaming"
      },
      {
        "rule_set": "netflix",
        "action": "route",
        "outbound": "streaming"
      },
      {
        "rule_set": "disney",
        "action": "route",
        "outbound": "streaming"
      },
      {
        "rule_set": "spotify",
        "action": "route",
        "outbound": "streaming"
      },
      {
        "rule_set": "tiktok",
        "action": "route",
        "outbound": "streaming"
      },
      {
        "rule_set": "telegram",
        "action": "route",
        "outbound": "telegram"
      },
      {
        "rule_set": "microsoft",
        "action": "route",
        "outbound": "microsoft"
      },
      {
        "rule_set": "onedrive",
        "action": "route",
        "outbound": "microsoft"
      },
      {
        "rule_set": "apple",
        "action": "route",
        "outbound": "apple"
      },
      {
        "rule_set": "google",
        "action": "route",
        "outbound": "google"
      },
      {
        "rule_set": "github",
        "action": "route",
        "outbound": "github"
      },
      {
        "rule_set": "geolocation-!cn",
        "action": "route",
        "outbound": "select"
      }
    ],
    "rule_set": [
      {
        "type": "remote",
        "tag": "geosite-private",
        "format": "binary",
        "url": "https://testingcf.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@sing/geo/geosite/private.srs",
        "http_client": "rule-set-direct"
      },
      {
        "type": "remote",
        "tag": "geoip-cn",
        "format": "binary",
        "url": "https://testingcf.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@sing/geo/geoip/cn.srs",
        "http_client": "rule-set-direct"
      },
      {
        "type": "remote",
        "tag": "geosite-cn",
        "format": "binary",
        "url": "https://testingcf.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@sing/geo/geosite/cn.srs",
        "http_client": "rule-set-direct"
      },
      {
        "type": "remote",
        "tag": "geolocation-!cn",
        "format": "binary",
        "url": "https://testingcf.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@sing/geo/geosite/geolocation-!cn.srs",
        "http_client": "rule-set-direct"
      },
      {
        "type": "remote",
        "tag": "category-ai-!cn",
        "format": "binary",
        "url": "https://testingcf.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@sing/geo/geosite/category-ai-!cn.srs",
        "http_client": "rule-set-direct"
      },
      {
        "type": "remote",
        "tag": "youtube",
        "format": "binary",
        "url": "https://testingcf.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@sing/geo/geosite/youtube.srs",
        "http_client": "rule-set-direct"
      },
      {
        "type": "remote",
        "tag": "netflix",
        "format": "binary",
        "url": "https://testingcf.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@sing/geo/geosite/netflix.srs",
        "http_client": "rule-set-direct"
      },
      {
        "type": "remote",
        "tag": "disney",
        "format": "binary",
        "url": "https://testingcf.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@sing/geo/geosite/disney.srs",
        "http_client": "rule-set-direct"
      },
      {
        "type": "remote",
        "tag": "spotify",
        "format": "binary",
        "url": "https://testingcf.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@sing/geo/geosite/spotify.srs",
        "http_client": "rule-set-direct"
      },
      {
        "type": "remote",
        "tag": "tiktok",
        "format": "binary",
        "url": "https://testingcf.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@sing/geo/geosite/tiktok.srs",
        "http_client": "rule-set-direct"
      },
      {
        "type": "remote",
        "tag": "telegram",
        "format": "binary",
        "url": "https://testingcf.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@sing/geo/geosite/telegram.srs",
        "http_client": "rule-set-direct"
      },
      {
        "type": "remote",
        "tag": "microsoft",
        "format": "binary",
        "url": "https://testingcf.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@sing/geo/geosite/microsoft.srs",
        "http_client": "rule-set-direct"
      },
      {
        "type": "remote",
        "tag": "onedrive",
        "format": "binary",
        "url": "https://testingcf.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@sing/geo/geosite/onedrive.srs",
        "http_client": "rule-set-direct"
      },
      {
        "type": "remote",
        "tag": "apple",
        "format": "binary",
        "url": "https://testingcf.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@sing/geo/geosite/apple.srs",
        "http_client": "rule-set-direct"
      },
      {
        "type": "remote",
        "tag": "google",
        "format": "binary",
        "url": "https://testingcf.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@sing/geo/geosite/google.srs",
        "http_client": "rule-set-direct"
      },
      {
        "type": "remote",
        "tag": "github",
        "format": "binary",
        "url": "https://testingcf.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@sing/geo/geosite/github.srs",
        "http_client": "rule-set-direct"
      }
    ],
    "final": "select",
    "default_domain_resolver": {
      "server": "direct-dns"
    },
    "default_http_client": "rule-set-direct",
    "auto_detect_interface": true
  },
  "experimental": {
    "clash_api": {
      "default_mode": "Rule"
    },
    "cache_file": {
      "enabled": true,
      "cache_id": "linux-1.14-tun"
    }
  },
  "http_clients": [
    {
      "tag": "rule-set-direct",
      "domain_resolver": {
        "server": "direct-dns-bootstrap",
        "strategy": "ipv4_only"
      }
    }
  ]
}
