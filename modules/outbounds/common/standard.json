{
  "outbounds": [
    {
      "type": "hysteria2",
      "tag": "proxy-example",
      "server": "example.com",
      "server_port": 443,
      "password": "CHANGE_ME",
      "tls": {"enabled": true, "server_name": "example.com", "insecure": false}
    },
    {
      "type": "selector",
      "tag": "select",
      "outbounds": ["auto", "proxy-example"],
      "default": "auto"
    },
    {
      "type": "urltest",
      "tag": "auto",
      "outbounds": ["proxy-example"],
      "url": "https://www.gstatic.com/generate_204",
      "interval": "10m",
      "tolerance": 150,
      "interrupt_exist_connections": false
    },
    {
      "type": "selector",
      "tag": "streaming",
      "outbounds": ["select", "auto", "direct"],
      "default": "select",
      "interrupt_exist_connections": false
    },
    {
      "type": "selector",
      "tag": "ai",
      "outbounds": ["select", "auto", "direct"],
      "default": "select",
      "interrupt_exist_connections": false
    },
    {
      "type": "selector",
      "tag": "telegram",
      "outbounds": ["select", "auto", "direct"],
      "default": "select",
      "interrupt_exist_connections": false
    },
    {
      "type": "selector",
      "tag": "microsoft",
      "outbounds": ["select", "auto", "direct"],
      "default": "select",
      "interrupt_exist_connections": false
    },
    {
      "type": "selector",
      "tag": "apple",
      "outbounds": ["select", "auto", "direct"],
      "default": "select",
      "interrupt_exist_connections": false
    },
    {
      "type": "selector",
      "tag": "google",
      "outbounds": ["select", "auto", "direct"],
      "default": "select",
      "interrupt_exist_connections": false
    },
    {
      "type": "selector",
      "tag": "github",
      "outbounds": ["select", "auto", "direct"],
      "default": "select",
      "interrupt_exist_connections": false
    },
    {"type": "direct", "tag": "direct"},
    {
      "type": "selector",
      "tag": "GLOBAL",
      "outbounds": ["select", "auto", "proxy-example", "direct"],
      "default": "select",
      "interrupt_exist_connections": false
    }
  ]
}
