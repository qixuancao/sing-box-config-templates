{
  "outbounds": [
    {
      "type": "hysteria2",
      "tag": "proxy-example",
      "server": "example.com",
      "server_port": 443,
      "password": "CHANGE_ME",
      "tls": {
        "enabled": true,
        "server_name": "example.com",
        "insecure": false
      }
    },
    {
      "type": "selector",
      "tag": "select",
      "outbounds": [
        "auto",
        "udp-auto",
        "proxy-example"
      ],
      "default": "udp-auto"
    },
    {
      "type": "urltest",
      "tag": "auto",
      "outbounds": [
        "proxy-example"
      ],
      "url": "https://www.gstatic.com/generate_204",
      "interval": "3m",
      "tolerance": 150,
      "interrupt_exist_connections": false
    },
    {
      "type": "urltest",
      "tag": "udp-auto",
